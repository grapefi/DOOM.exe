# Never put a private key in a VITE_ variable. .env is ignored by git.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PRIVATE_KEY=
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Fill after successful deployment and verification; rebuild frontend afterwards.
VITE_MANIFEST_ADDRESS=0x9263dcd41931a92055188d9a5f8689eac0c4f03b
# Optional independent pin printed by bundle. Set for public deployments.
VITE_ROM_HASH=0x56b8aab9eeecb7a2b78e3532e442f038eb0c4806fe519bd6a05b47135633aabf

# Required only for --broadcast. Set your own cumulative fee cap in ETH.
MAX_DEPLOYMENT_ETH=
