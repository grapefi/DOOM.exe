# Never put a private key in a VITE_ variable. .env is ignored by git.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
PRIVATE_KEY=
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional override; published mainnet address is in shared/mainnetDeployment.json.
VITE_MANIFEST_ADDRESS=
# Optional override for the independently pinned mainnet cartridge hash.
VITE_ROM_HASH=

# Required only for --broadcast. Set your own cumulative fee cap in ETH.
MAX_DEPLOYMENT_ETH=
